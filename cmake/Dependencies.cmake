# No configure/build network access. Archives must be explicitly prepared first.
function(lead_a1_unpack_dependency name output)
  file(READ "${CMAKE_CURRENT_SOURCE_DIR}/doc/dependencies.json" manifest)
  foreach(field file bytes sha256 directory)
    string(JSON ${field} GET "${manifest}" "${name}" "${field}")
  endforeach()
  set(archive "${CMAKE_CURRENT_SOURCE_DIR}/doc/local/dependencies/${file}")
  if(NOT EXISTS "${archive}")
    message(FATAL_ERROR "Missing ${name}: run python3 tools/dependencies.py --fetch")
  endif()
  file(SIZE "${archive}" actual_size)
  file(SHA256 "${archive}" actual_hash)
  if(NOT actual_size EQUAL bytes OR NOT actual_hash STREQUAL sha256)
    message(FATAL_ERROR "Pinned ${name} size/SHA-256 mismatch")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${archive}" "${CMAKE_CURRENT_SOURCE_DIR}/doc/dependencies.json")
  set(stage "${CMAKE_CURRENT_BINARY_DIR}/generated/${name}-stage")
  set(source "${CMAKE_CURRENT_BINARY_DIR}/generated/${name}")
  file(REMOVE_RECURSE "${stage}")
  file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${stage}")
  file(GLOB_RECURSE staged_files RELATIVE "${stage}/${directory}" "${stage}/${directory}/*")
  foreach(relative IN LISTS staged_files)
    get_filename_component(parent "${relative}" DIRECTORY)
    file(MAKE_DIRECTORY "${source}/${parent}")
    file(COPY_FILE "${stage}/${directory}/${relative}" "${source}/${relative}" ONLY_IF_DIFFERENT)
  endforeach()
  file(REMOVE_RECURSE "${stage}")
  set(${output} "${source}" PARENT_SCOPE)
endfunction()

lead_a1_unpack_dependency(lzo LEAD_A1_LZO_SOURCE)
file(SHA256 "${LEAD_A1_LZO_SOURCE}/COPYING" lzo_notice)
file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/LICENSES/LZO-GPL2.txt" packaged_notice)
if(NOT lzo_notice STREQUAL packaged_notice)
  message(FATAL_ERROR "Packaged LZO license differs from pinned source")
endif()
add_library(lead_a1_lzo STATIC "${LEAD_A1_LZO_SOURCE}/minilzo/minilzo.c")
target_include_directories(lead_a1_lzo SYSTEM PUBLIC "${LEAD_A1_LZO_SOURCE}/minilzo"
  "${LEAD_A1_LZO_SOURCE}/include" "${LEAD_A1_LZO_SOURCE}/include/lzo")
# Upstream-supported bytewise access retains checks on hosts with strict alignment.
target_compile_definitions(lead_a1_lzo PRIVATE LZO_CFG_NO_UNALIGNED=1)
lead_a1_harden_native(lead_a1_lzo)
if(DEFINED lead_a1_dependency_sanitizers)
  target_compile_options(lead_a1_lzo PRIVATE
    "-fsanitize=${lead_a1_dependency_sanitizers}" -fno-sanitize-recover=all
    -fno-omit-frame-pointer -g)
endif()
